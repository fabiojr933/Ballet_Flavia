<!DOCTYPE html>
<html lang="pt-br">
<%- include('../partials/head.ejs') %>

<style>
  body { background: #f6f9ff; }

  /* Header e Título */
  .attendance-header h2 {
    font-size: 24px;
    font-weight: 700;
    color: #012970;
    margin-bottom: 2px;
  }
  .attendance-header p {
    color: #899bbd;
    font-size: 13px;
    margin-bottom: 25px;
  }

  /* Card de Registro Superior */
  .card-registration {
    background: #fff;
    border-radius: 25px;
    padding: 25px 40px;
    box-shadow: 0 10px 30px rgba(1, 41, 112, 0.05);
    margin-bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: none;
  }

  .registration-info h3 { font-size: 20px; font-weight: 700; color: #012970; margin: 0; }
  .registration-info p { font-size: 13px; color: #899bbd; margin: 0; }

  .date-picker-custom {
    background: #f0f4ff;
    border: none;
    border-radius: 12px;
    padding: 10px 15px;
    color: #4154f1;
    font-weight: 600;
    outline: none;
  }

  .btn-finalize {
    background: #5138ed;
    color: #fff;
    border: none;
    border-radius: 15px;
    padding: 12px 25px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 20px rgba(81, 56, 237, 0.25);
    transition: 0.3s;
  }
  .btn-finalize:disabled {
    background: #a59ae9;
    cursor: not-allowed;
  }

  /* Filtros de Turma */
  .class-filter-container {
    display: flex;
    gap: 12px;
    margin-bottom: 25px;
  }

  .btn-filter-class {
    background: #fff;
    color: #798eb3;
    border: 2px solid #e0e6ed;
    border-radius: 16px;
    padding: 12px 24px;
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .btn-filter-class:hover {
    background: #f0f4ff;
    color: #4154f1;
    border-color: #bcd0ff;
  }

  .btn-filter-class.active {
    background: #4154f1;
    color: #fff;
    border-color: #4154f1;
    box-shadow: 0 8px 20px rgba(65, 84, 241, 0.2);
  }

  /* Controle de Visibilidade */
  .class-section {
    display: none;
  }
  
  .class-section.active-section {
    display: block;
  }

  .class-section-title {
    font-size: 18px;
    font-weight: 700;
    color: #012970;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Lista de Chamada */
  .attendance-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 0 25px rgba(1, 41, 112, 0.08);
    overflow: hidden;
    margin-bottom: 20px;
  }

  .list-header {
    padding: 15px 25px;
    border-bottom: 1px solid #f0f4ff;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .list-header span { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #4154f1; }

  .student-row {
    padding: 15px 25px;
    border-bottom: 1px solid #f0f4ff;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .student-profile { display: flex; align-items: center; gap: 15px; }

  .avatar {
    width: 45px;
    height: 45px;
    background: #eef2ff;
    color: #4154f1;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .student-name { font-weight: 700; color: #012970; font-size: 15px; margin: 0; }
  .student-meta { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #4154f1; }

  /* Botões de Status */
  .status-actions { display: flex; gap: 10px; }

  .btn-status {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.3s;
    background: #f8f9fa;
    color: #adb5bd;
  }

  .btn-status.btn-present.active {
    background: #00d26a; 
    color: #fff;
    box-shadow: 0 4px 12px rgba(0, 210, 106, 0.3);
  }

  .btn-status.btn-absent.active {
    background: #ff4d4d;
    color: #fff;
    box-shadow: 0 4px 12px rgba(255, 77, 77, 0.3);
  }

  .tip-box {
    background: #eef2ff;
    border-radius: 15px;
    padding: 15px 25px;
    margin-top: 15px;
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 15px;
    color: #4154f1;
    font-size: 13px;
    border-left: 4px solid #5138ed;
  }

  @media (max-width: 768px) {
    .card-registration { flex-direction: column; align-items: stretch !important; gap: 20px; padding: 20px; }
    .registration-info { text-align: center; }
    .card-registration .d-flex { flex-direction: column; width: 100%; }
    .date-picker-custom, .btn-finalize { width: 100%; justify-content: center; }
    .class-filter-container { flex-direction: column; }
    .student-row { flex-direction: column; gap: 15px; align-items: flex-start; padding: 15px; }
    .status-actions { width: 100%; justify-content: flex-end; }
  }
</style>

<body>
  <%- include('../partials/header.ejs') %>
  <%- include('../partials/sidebar.ejs') %>

  <main id="main" class="main">
    
    <div class="attendance-header">
      <h2>Chamada do Dia</h2>
      <p>Equipe de Ballet • Gestão por Turmas</p>
    </div>

    <div class="card card-registration">
      <div class="registration-info">
        <h3>Registro de Chamada</h3>
        <p>Selecione a data, escolha a turma abaixo e confirme as presenças.</p>
      </div>
      
      <div class="d-flex gap-2">
        <input type="date" id="input-data-chamada" class="date-picker-custom">
        <button class="btn-finalize" id="btn-finalizar-chamada">
          <i class="bi bi-journal-check"></i>
          <span>Finalizar Chamada</span>
        </button>
      </div>
    </div>

    <% if (typeof alunas !== 'undefined' && alunas.length > 0) { 
        const turmaBaby = alunas.filter(a => a.turma == '1');
        const turmaInfantil = alunas.filter(a => a.turma != '1');
    %>

      <div class="class-filter-container">
        <% if (turmaBaby.length > 0) { %>
          <button class="btn-filter-class active" data-target="secao-baby" data-turma-id="1">
            <i class="bi bi-person-hearts"></i> Turma Baby (4/6 anos)
          </button>
        <% } %>
        
        <% if (turmaInfantil.length > 0) { %>
          <button class="btn-filter-class <%= turmaBaby.length === 0 ? 'active' : '' %>" data-target="secao-infantil" data-turma-id="2">
            <i class="bi bi-stars"></i> Turma Infantil (7/11 anos)
          </button>
        <% } %>
      </div>


      <% if (turmaBaby.length > 0) { %>
        <div id="secao-baby" class="class-section active-section">
          <div class="class-section-title">
            <i class="bi bi-person-hearts text-primary"></i> Chamada Ativa: Turma Baby (4/6 anos)
          </div>

          <div class="attendance-card">
            <div class="list-header">
              <span>Lista de Presença</span>
              <span class="badge bg-light text-primary border"><%= turmaBaby.length %> matriculadas</span>
            </div>

            <% turmaBaby.forEach(aluna => { 
                let iniciais = aluna.nome.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            %>
              <div class="student-row">
                <div class="student-profile">
                  <div class="avatar"><%= iniciais %></div>
                  <div>
                    <h4 class="student-name"><%= aluna.nome %></h4>
                    <span class="student-meta">CRIANÇAS • 4/6 ANOS</span>
                  </div>
                </div>
                <div class="status-actions">
                  <button class="btn-status btn-present" data-student="<%= aluna.id %>" data-status="presente"><i class="bi bi-check-lg"></i></button>
                  <button class="btn-status btn-absent" data-student="<%= aluna.id %>" data-status="ausente"><i class="bi bi-x-lg"></i></button>
                </div>
              </div>
            <% }) %>
          </div>

          <div class="tip-box">
            <i class="bi bi-magic fs-5"></i>
            <span><strong>Dica para a Turma Baby:</strong> O foco hoje é o lúdico! Estimule a postura de "princesa/príncipe" antes de iniciar a chamada para prender a atenção.</span>
          </div>
        </div>
      <% } %>


      <% if (turmaInfantil.length > 0) { %>
        <div id="secao-infantil" class="class-section <%= turmaBaby.length === 0 ? 'active-section' : '' %>">
          <div class="class-section-title">
            <i class="bi bi-stars text-primary"></i> Chamada Ativa: Turma Infantil (7/11 anos)
          </div>

          <div class="attendance-card">
            <div class="list-header">
              <span>Lista de Presença</span>
              <span class="badge bg-light text-primary border"><%= turmaInfantil.length %> matriculadas</span>
            </div>

            <% turmaInfantil.forEach(aluna => { 
                let iniciais = aluna.nome.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            %>
              <div class="student-row">
                <div class="student-profile">
                  <div class="avatar"><%= iniciais %></div>
                  <div>
                    <h4 class="student-name"><%= aluna.nome %></h4>
                    <span class="student-meta">INFANTIL • 7/11 ANOS</span>
                  </div>
                </div>
                <div class="status-actions">
                  <button class="btn-status btn-present" data-student="<%= aluna.id %>" data-status="presente"><i class="bi bi-check-lg"></i></button>
                  <button class="btn-status btn-absent" data-student="<%= aluna.id %>" data-status="ausente"><i class="bi bi-x-lg"></i></button>
                </div>
              </div>
            <% }) %>
          </div>

          <div class="tip-box">
            <i class="bi bi-activity fs-5"></i>
            <span><strong>Dica para a Turma Infantil:</strong> Cronometre o aquecimento. Essa faixa etária responde muito bem a metas de tempo e desafios de flexibilidade!</span>
          </div>
        </div>
      <% } %>

    <% } else { %>
      <div class="attendance-card p-5 text-center text-muted">
        <i class="bi bi-people fs-1 text-secondary mb-3"></i>
        <p class="mb-0">Nenhuma aluna cadastrada.</p>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer.ejs') %>
  <%- include('../partials/script.ejs') %>

  <script>
    // INSERIR A DATA ATUAL AUTOMATICAMENTE NO INPUT
    window.addEventListener('DOMContentLoaded', () => {
      const inputData = document.getElementById('input-data-chamada');
      const hoje = new Date();
      
      // Ajusta o fuso horário para o padrão ISO (YYYY-MM-DD) local do Brasil
      const ano = hoje.getFullYear();
      const mes = String(hoje.getMonth() + 1).padStart(2, '0');
      const dia = String(hoje.getDate()).padStart(2, '0');
      
      inputData.value = `${ano}-${mes}-${dia}`;
    });

    // Gerenciador de Alternância de Abas das Turmas
    document.querySelectorAll('.btn-filter-class').forEach(button => {
      button.addEventListener('click', function() {
        document.querySelectorAll('.btn-filter-class').forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');

        document.querySelectorAll('.class-section').forEach(section => section.classList.remove('active-section'));

        const targetId = this.getAttribute('data-target');
        const targetSection = document.getElementById(targetId);
        if(targetSection) {
          targetSection.classList.add('active-section');
        }
      });
    });

    // Gerenciamento de clique individual para marcar Verde / Vermelho
    document.querySelectorAll('.btn-status').forEach(button => {
      button.addEventListener('click', function() {
        this.parentElement.querySelectorAll('.btn-status').forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
      });
    });

    // LÓGICA DE ENVIO EM MASSA (POST /chamada)
    document.getElementById('btn-finalizar-chamada').addEventListener('click', async function() {
      const secaoAtiva = document.querySelector('.class-section.active-section');
      const filtroAtivo = document.querySelector('.btn-filter-class.active');
      
      if (!secaoAtiva) {
        alert('Nenhuma turma selecionada para realizar a chamada.');
        return;
      }

      const turmaId = filtroAtivo.getAttribute('data-turma-id');
      const dataChamada = document.getElementById('input-data-chamada').value;

      const linhasAlunas = secaoAtiva.querySelectorAll('.student-row');
      const listaChamada = [];
      let temAlunaSemMarcacao = false;

      linhasAlunas.forEach(linha => {
        const botaoAtivo = linha.querySelector('.btn-status.active');

        if (!botaoAtivo) {
          temAlunaSemMarcacao = true;
          linha.style.background = '#edb9b9';
        } else {
          linha.style.background = 'transparent';
          const alunaId = botaoAtivo.getAttribute('data-student');
          const status = botaoAtivo.getAttribute('data-status');

          listaChamada.push({
            alunaId: alunaId,
            status: status
          });
        }
      });

      if (temAlunaSemMarcacao) {
        alert('Atenção: Existem alunas na lista que não foram marcadas! Verifique os itens destacados em vermelho.');
        return;
      }

      const payload = {
        data: dataChamada,
        turmaId: turmaId,
        chamada: listaChamada
      };

      try {
        this.disabled = true;
        this.innerHTML = '<i class="bi bi-hourglass-split"></i><span>Enviando...</span>';

        const resposta = await fetch('/chamada', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (resposta.ok) {
         // alert('Chamada gravada e enviada com sucesso!');

          location.href = '/chamada/realizada';
        } else {
          const erroTexto = await resposta.text();
          alert('Erro ao salvar chamada: ' + erroTexto);
        }

      } catch (error) {
        console.error('Erro de conexão:', error);
        alert('Erro crítico de rede. Não foi possível falar com o servidor.');
      } finally {
        this.disabled = false;
        this.innerHTML = '<i class="bi bi-journal-check"></i><span>Finalizar Chamada</span>';
      }
    });
  </script>

</body>
</html>