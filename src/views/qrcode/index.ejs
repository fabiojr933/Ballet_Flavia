<!DOCTYPE html>
<html lang="pt-br">
<%- include('../partials/head.ejs') %>

<style>
  /* CONFIGURAÇÃO PARA O RODAPÉ FICAR EM BAIXO */
  html, body {
    height: 100%;
    margin: 0;
  }

  body {
    background: #f6f9ff;
    display: flex;
    flex-direction: column; /* Organiza os elementos em coluna */
  }

  #main {
    flex: 1; /* Faz o conteúdo principal ocupar todo o espaço disponível, empurrando o footer */
    padding: 20px;
  }

  /* ESTILO DO RODAPÉ */
  footer#footer {
    background: #fff;
    padding: 20px 0;
    font-size: 14px;
    border-top: 1px solid #ebeef4;
    color: #012970;
    text-align: center;
  }

  /* CARD E OUTROS ESTILOS */
  .dashboard-header { margin-bottom: 20px; }
  .dashboard-title h2 { font-size: 26px; font-weight: 700; color: #012970; }
  .dashboard-title p { color: #899bbd; font-size: 14px; }

  .whatsapp-connect-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(1, 41, 112, 0.05);
    border: 1px solid #ebeef4;
    max-width: 950px;
    margin: 0 auto;
  }

  .connect-left { padding: 40px; border-right: 1px solid #ebeef4; }
  .connect-title { font-size: 24px; font-weight: 700; color: #012970; margin-bottom: 30px; }
  .connect-title span { color: #4154f1; }
  .step-list { display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px; }
  .step-item { display: flex; align-items: center; gap: 12px; }
  .step-number { 
    width: 32px; height: 32px; min-width: 32px; border-radius: 50%; 
    background: #f0f2ff; border: 1px solid #4154f1; color: #4154f1; 
    display: flex; align-items: center; justify-content: center; font-weight: 700; 
  }
  .step-text { color: #5c677d; font-size: 15px; font-weight: 500; }

  .tip-box { 
    background: #fff8e8; border: 1px solid #ffe6a6; border-radius: 10px; 
    padding: 12px 15px; display: flex; align-items: center; gap: 10px; 
  }
  .tip-box p { margin: 0; color: #8b5e00; font-size: 13px; font-weight: 600; }

  .connect-right { padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fafbff; }
  .qr-wrapper { width: 250px; height: 250px; border-radius: 20px; border: 2px dashed #d0d7f7; background: #fff; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
  .qr-inner img { width: 200px; height: 200px; object-fit: contain; }
  .scan-text { font-size: 14px; color: #899bbd; font-weight: 600; }

  @media (max-width: 991px) {
    .connect-left { border-right: none; border-bottom: 1px solid #ebeef4; }
  }
</style>

<body>

  <%- include('../partials/header.ejs') %>
  <%- include('../partials/sidebar.ejs') %>

  <main id="main" class="main">
    <div class="dashboard-header">
      <div class="dashboard-title">
        <h2>Conectar WhatsApp</h2>
        <p>Siga os passos abaixo para autenticar sua conta.</p>
      </div>
    </div>

    <div class="whatsapp-connect-card">
      <div class="row g-0">
        <div class="col-lg-6">
          <div class="connect-left">
            <h2 class="connect-title">Conecte seu <span>WhatsApp</span></h2>
            <div class="step-list">
              <div class="step-item"><div class="step-number">1</div><div class="step-text">Abra o WhatsApp no seu celular</div></div>
              <div class="step-item"><div class="step-number">2</div><div class="step-text">Toque em Dispositivos Conectados</div></div>
              <div class="step-item"><div class="step-number">3</div><div class="step-text">Toque em Conectar um aparelho</div></div>
              <div class="step-item"><div class="step-number">4</div><div class="step-text">Aponte a câmera para o QR Code</div></div>
            </div>
            <div class="tip-box"><i class="bi bi-lightbulb-fill"></i><p>Dica: Mantenha o celular conectado à internet.</p></div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="connect-right">
            <div class="qr-wrapper">
              <div class="qr-inner">
                <% if (typeof qrcode !== 'undefined' && qrcode) { %>
                  <img src="<%= (typeof qrcode === 'object') ? qrcode.QRCode : qrcode %>" alt="QR Code">
                <% } else { %>
                  <div class="text-center text-primary"><i class="bi bi-qr-code-scan" style="font-size: 40px;"></i><br><small>GERANDO...</small></div>
                <% } %>
              </div>
            </div>
            <div class="scan-text">Aguardando leitura do código</div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer id="footer" class="footer">
    <div class="copyright">
      &copy; <strong><span>FoxSistemas</span></strong> Todos os direitos reservados.
    </div>
  </footer>

  <%- include('../partials/script.ejs') %>

  <script>
    $(document).ready(function() {
        setInterval(function() {
            location.reload();
        }, 20000);
    });
  </script>
</body>
</html>