<!DOCTYPE html>
<html lang="pt-br">
<%- include('../partials/head.ejs') %>

<style>
  body { background: #f6f9ff; }
  
  /* HEADER */
  .dashboard-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 20px; flex-wrap: wrap; gap: 10px;
  }
  .dashboard-title h2 { font-size: 28px; font-weight: 700; color: #012970; margin-bottom: 4px; }
  .dashboard-title p { color: #899bbd; margin: 0; font-size: 14px; }

  .btn-new-campaign {
    background: #4154f1; border: none; color: #fff; padding: 10px 18px;
    border-radius: 8px; font-weight: 600; font-size: 14px;
    display: flex; align-items: center; gap: 8px; transition: 0.3s; text-decoration: none;
  }
  .btn-new-campaign:hover { background: #5969f3; color: #fff; }

  /* CARDS PRINCIPAIS */
  .dashboard-card {
    background: #fff; border-radius: 16px; padding: 18px;
    box-shadow: 0 5px 20px rgba(1, 41, 112, 0.05);
    height: 100%; display: flex; align-items: center; gap: 15px;
  }
  .dashboard-card .icon-box {
    width: 48px; height: 48px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;
  }
  .dashboard-card .card-info { display: flex; flex-direction: column; }
  .dashboard-card span { font-size: 11px; font-weight: 700; color: #899bbd; letter-spacing: 0.5px; }
  .dashboard-card h3 { font-size: 26px; font-weight: 700; color: #012970; margin: 0; line-height: 1.2; }

  /* CORES DOS ÍCONES */
  .icon-primary { background: #f6f6fe; color: #4154f1; }
  .icon-success { background: #e0f8e9; color: #2eca6a; }
  .icon-warning { background: #fff3cd; color: #ff771d; }
  .icon-info { background: #e7f1ff; color: #0dcaf0; }
  .icon-purple { background: #f3f0ff; color: #6f42c1; }

  /* SEÇÃO DE CONTEÚDO */
  .activity-card { background: #fff; border-radius: 12px; box-shadow: 0 0 20px rgba(1, 41, 112, 0.08); overflow: hidden; height: 100%; }
  .activity-header { display: flex; justify-content: space-between; align-items: center; padding: 18px 20px; border-bottom: 1px solid #ebeef4; }
  .activity-header h4 { margin: 0; font-size: 18px; font-weight: 700; color: #012970; }
  
  .activity-item { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #ebeef4; }
  .activity-item:last-child { border-bottom: none; }
  .activity-left { display: flex; align-items: center; gap: 14px; }
  .activity-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 17px; }
  .activity-content h5 { margin: 0; font-size: 15px; font-weight: 600; color: #012970; }
  .activity-content p { margin: 2px 0 0; color: #899bbd; font-size: 13px; }

  /* CARD DISPOSITIVO */
  .device-card { background: #4154f1; border-radius: 12px; padding: 25px; color: #fff; height: 100%; box-shadow: 0 0 20px rgba(65, 84, 241, 0.2); }
  .device-top { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .device-top i { font-size: 24px; }
  .device-top h3 { margin: 0; font-size: 22px; font-weight: 700; }
  .device-card p { color: rgba(255, 255, 255, 0.9); font-size: 14px; line-height: 1.7; margin-bottom: 30px; }
  
  .connect-btn { width: 100%; border: none; background: #fff; color: #4154f1; border-radius: 10px; padding: 14px; font-size: 15px; font-weight: 700; transition: 0.3s; }
  .connect-btn:hover { background: #f2f2f2; }

  @media (max-width: 768px) {
    .dashboard-title h2, .dashboard-card h3, .device-top h3 { font-size: 20px; }
  }

  /* CARD BALLET AJUSTADO (MENOR) */
  .ballet-inspiration-card {
    height: 100%;
    background: linear-gradient(135deg, #ffb7d5, #ff85c2, #b06dfc);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(176,109,252,.2);
    padding: 15px 10px;
  }

  .ballet-animation {
    height: 150px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* BAILARINA REDUZIDA PROPORCIONALMENTE */
  .ballerina {
    position: relative;
    width: 90px;
    height: 135px;
    animation: spinDance 6s infinite ease-in-out;
  }

  .head {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #ffe0c7;
    position: absolute;
    left: 33px;
    top: 0;
  }

  .body {
    width: 15px;
    height: 42px;
    border-radius: 15px;
    background: white;
    position: absolute;
    left: 37px;
    top: 21px;
  }

  .skirt {
    width: 68px;
    height: 34px;
    background: #ffd2e7;
    clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
    position: absolute;
    left: 11px;
    top: 52px;
  }

  .arm {
    width: 42px;
    height: 6px;
    border-radius: 8px;
    background: #ffe0c7;
    position: absolute;
    top: 34px;
  }

  .arm-left {
    left: 0;
    transform-origin: right center;
    animation: leftArm 2s infinite alternate;
  }

  .arm-right {
    right: 0;
    transform-origin: left center;
    animation: rightArm 2s infinite alternate;
  }

  .leg {
    width: 5px;
    height: 50px;
    border-radius: 8px;
    background: #ffe0c7;
    position: absolute;
    top: 80px;
  }

  .leg-left {
    left: 38px;
  }

  .leg-right {
    left: 49px;
  }

  /* TEXTOS E ELEMENTOS DO BALLET AJUSTADOS */
  .ballet-message {
    text-align: center;
    color: white;
    padding: 10px 15px;
  }

  .ballet-message h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .ballet-message p {
    font-size: 13px;
    line-height: 1.6;
    opacity: .95;
    margin-bottom: 15px;
  }

  .quote-line {
    width: 60px;
    height: 2px;
    background: rgba(255,255,255,.6);
    margin: 0 auto 10px;
    border-radius: 10px;
  }

  .ballet-message small {
    font-size: 12px;
    opacity: .85;
    font-style: italic;
  }

  /* ESTRELAS */
  .star {
    position: absolute;
    border-radius: 50%;
    background: white;
    opacity: .8;
    animation: shine 2s infinite;
  }

  .star1 { width: 6px; height: 6px; left: 30%; top: 25%; }
  .star2 { width: 5px; height: 5px; right: 25%; top: 15%; }
  .star3 { width: 8px; height: 8px; bottom: 15%; left: 65%; }

  /* ANIMAÇÕES */
  @keyframes spinDance {
    0%, 100% { transform: rotate(-6deg) translateY(0); }
    25% { transform: rotate(6deg) translateY(-6px); }
    50% { transform: rotate(0deg) translateY(0); }
    75% { transform: rotate(-6deg) translateY(-6px); }
  }

  @keyframes leftArm {
    from { transform: rotate(-35deg); }
    to { transform: rotate(20deg); }
  }

  @keyframes rightArm {
    from { transform: rotate(35deg); }
    to { transform: rotate(-20deg); }
  }

  @keyframes shine {
    0%, 100% { opacity: .3; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }
</style>

<body>
  <%- include('../partials/header.ejs') %>
  <%- include('../partials/sidebar.ejs') %>

  <main id="main" class="main" style="min-height: calc(100vh - 100px);">

    <div class="dashboard-header">
      <div class="dashboard-title">
        <h2>Dashboard</h2>
        <p>Bem-vindo ao centro de operações das suas campanhas.</p>
      </div>
      <a href="/campanha" class="btn-new-campaign">
        <i class="bi bi-plus-lg"></i> Nova Campanha
      </a>
    </div>

    <div class="row g-3 mb-4">

      <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-card">
          <div class="icon-box icon-purple">
            <i class="bi bi-people-fill"></i>
          </div>
          <div class="card-info">
            <span>Total de Matriculas</span>
            <h3><%= data.contato %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-card">
          <div class="icon-box icon-success">
            <i class="bi bi-graph-up-arrow"></i>
          </div>
          <div class="card-info">
            <span>Taxa de Presença</span>
            <h3><%= presenca ?? 0 %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-card">
          <div class="icon-box icon-success">
            <i class="bi bi-send"></i>
          </div>
          <div class="card-info">
            <span>Total de Campanhas</span>
            <h3><%= data.campanha %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-card">
          <div class="icon-box icon-primary">
            <i class="bi bi-check-circle"></i>
          </div>
          <div class="card-info">
            <span>Mensagem Enviadas</span>
            <h3><%= data.mensagem_enviada %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-card">
          <div class="icon-box icon-warning">
            <i class="bi bi-clock"></i>
          </div>
          <div class="card-info">
            <span>Mensagem Agendadas</span>
            <h3><%= data.mensagem_agendada %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-card">
          <div class="icon-box icon-info">
            <i class="bi bi-people"></i>
          </div>
          <div class="card-info">
            <span>Contatos</span>
            <h3><%= data.contato %></h3>
          </div>
        </div>
      </div>

    </div>

    <div class="row g-3">

      <div class="col-lg-7">
        <div class="activity-card">
          <div class="activity-header">
            <h4>Atividade Recente</h4>            
          </div>

          <% if (typeof agendado !== 'undefined' && agendado.length > 0) { %>
            <% agendado.forEach(item => { %>
              <div class="activity-item">
                <div class="activity-left">
                  <div class="activity-icon icon-warning">
                    <i class="bi bi-clock"></i>
                  </div>
                  <div class="activity-content">
                    <h5><%= item.nome %></h5>
                    <p>Agendado para 
                      <%= new Date(item.proxima_execucao).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %> às 
                      <%= new Date(item.proxima_execucao).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %> horas
                    </p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center text-muted py-5">
              <p class="mb-0">Nenhuma campanha cadastrada.</p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="ballet-inspiration-card">

          <div class="ballet-animation">
            <div class="star star1"></div>
            <div class="star star2"></div>
            <div class="star star3"></div>

            <div class="ballerina">
              <div class="head"></div>
              <div class="body"></div>
              <div class="arm arm-left"></div>
              <div class="arm arm-right"></div>
              <div class="skirt"></div>
              <div class="leg leg-left"></div>
              <div class="leg leg-right"></div>
            </div>
          </div>

          <div class="ballet-message">
            <h3>🩰 Inspire. Ensine. Transforme.</h3>
            <p>
              Cada aula é uma oportunidade de despertar confiança,
              disciplina e amor pela dança. Continue formando sonhos
              através do ballet.
            </p>
            <div class="quote-line"></div>
            <small>
              "A dança é a linguagem escondida da alma."
            </small>
          </div>

        </div>
      </div>     

    </div>
  </main>

  <%- include('../partials/footer.ejs') %>
  <%- include('../partials/script.ejs') %>
</body>
</html>